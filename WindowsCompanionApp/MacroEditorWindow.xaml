<Window x:Class="VSDM18App.MacroEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Macros" Width="1000" Height="750"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="{StaticResource Base}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Macro list -->
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16">
                <TextBlock DockPanel.Dock="Top" Text="Your macros" Style="{StaticResource SectionTitle}"/>
                <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="0,10,0,0">
                    <Button Content="New" Click="NewMacro_Click"/>
                    <Button Content="Copy" Click="CopyMacro_Click"/>
                    <Button Content="Delete" Click="DeleteMacro_Click"/>
                </UniformGrid>
                <ListBox x:Name="MacroList" SelectionChanged="MacroList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Editor -->
        <Grid Grid.Column="1" x:Name="RightPane" Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Name" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/>
                    <TextBox x:Name="NameBox" TextChanged="NameBox_TextChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" Width="200">
                    <TextBlock Text="Plays" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="ModeBox" DisplayMemberPath="Text" SelectedValuePath="Value"
                              SelectionChanged="ModeBox_SelectionChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="14,0,0,0" Width="120">
                    <TextBlock Text="Pause between repeats (ms)" Foreground="{StaticResource Muted}" Margin="0,0,0,5"
                               TextTrimming="CharacterEllipsis" ToolTip="Pause between repeats (ms)"/>
                    <TextBox x:Name="GapBox" LostFocus="GapBox_LostFocus"/>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1" x:Name="ModeHint" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                       Margin="0,10,0,10"/>

            <Border Grid.Row="2" Background="{StaticResource Inset}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="8" Padding="6">
                <ListBox x:Name="StepList" SelectionChanged="StepList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Summary}"/></DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <WrapPanel>
                    <Button x:Name="RecordButton" Content="Record keys" Style="{StaticResource AccentButton}"
                            Click="Record_Click"/>
                    <Button Content="Add step" Click="AddStep_Click"/>
                    <Button Content="Move up" Click="MoveUp_Click"/>
                    <Button Content="Move down" Click="MoveDown_Click"/>
                    <Button Content="Remove step" Click="RemoveStep_Click"/>
                    <Button Content="Tidy" Click="Tidy_Click"
                            ToolTip="Merge recorded key down / up pairs into single key presses."/>
                    <Button x:Name="TestButton" Content="Test in 3 seconds" Click="Test_Click"
                            ToolTip="Gives you time to click into a game or text box first."/>
                </WrapPanel>
                <TextBlock x:Name="RecordHint" Visibility="Collapsed" Foreground="{StaticResource Accent}"
                           TextWrapping="Wrap" Margin="2,6,0,0"
                           Text="Recording every key you press, in any program, including Alt+Tab. Press Stop recording when done, then remove any extra steps."/>
            </StackPanel>

            <Border Grid.Row="4" x:Name="StepEditor" Margin="0,12,0,0" Padding="14" CornerRadius="8"
                    Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Step" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="StepTypeBox" DisplayMemberPath="Text" SelectedValuePath="Value"
                                  SelectionChanged="StepTypeBox_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <StackPanel x:Name="KeyRow">
                            <TextBlock Text="Key" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Keyboard" Click="PickStepKey_Click" Margin="6,0,0,0"/>
                                <TextBox x:Name="StepKeyBox" ToolTip="Click here, then press the key."/>
                            </DockPanel>
                        </StackPanel>
                        <StackPanel x:Name="MouseRow" Visibility="Collapsed">
                            <TextBlock Text="Mouse button" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/>
                            <ComboBox x:Name="StepMouseBox" SelectionChanged="StepMouseBox_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel x:Name="TextRow" Visibility="Collapsed">
                            <TextBlock Text="Text to type" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/>
                            <TextBox x:Name="StepTextBox" TextChanged="StepTextBox_TextChanged"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="14,0,0,0" x:Name="MsRow">
                        <TextBlock x:Name="MsLabel" Text="Milliseconds" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/>
                        <TextBox x:Name="StepMsBox" TextChanged="StepMsBox_TextChanged"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

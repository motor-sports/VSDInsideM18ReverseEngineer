<Window x:Class="VSDM18App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VSDM18App"
        Title="VSDM18 Deck" MaxWidth="1220" MaxHeight="750" MinWidth="1220" MinHeight="750"
        ResizeMode="NoResize"
        Background="{StaticResource Base}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <DataTemplate x:Key="KeyTemplate" DataType="{x:Type local:KeyTile}">
            <Border Width="94" Height="112" Margin="5" CornerRadius="10" Background="#0E0F12"
                    BorderThickness="2" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel Margin="5">
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Caption}" FontSize="10.5" Height="14"
                               Foreground="{StaticResource Muted}" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                    <Image Source="{Binding Preview}" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SideTemplate" DataType="{x:Type local:KeyTile}">
            <Border Width="150" Height="56" Margin="5" CornerRadius="10" Background="#0E0F12"
                    BorderThickness="2" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel VerticalAlignment="Center" Margin="10,0">
                    <TextBlock TextAlignment="Center" Text="{Binding Title}" FontWeight="SemiBold"/>
                    <TextBlock TextAlignment="Center" Text="{Binding Caption}" FontSize="11" Foreground="{StaticResource Muted}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="AdminButton" Content="Run as administrator" Click="Admin_Click"
                            ToolTip="Games running as administrator ignore key presses from normal programs. Restart this app as administrator so it works with them."/>
                    <Button x:Name="ConnectButton" Content="Connect" MinWidth="100"
                            Style="{StaticResource AccentButton}" Click="Connect_Click"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource Muted}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="StatusText" Text="Not connected" FontSize="14" FontWeight="SemiBold"
                               MaxWidth="620" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="AdminBadge" Text="Administrator" Foreground="{StaticResource Good}"
                               Margin="16,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Presets -->
            <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Presets" Style="{StaticResource SectionTitle}"/>
                        <ListBox x:Name="ProfileList" MaxHeight="230" SelectionChanged="ProfileList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <UniformGrid Columns="2" Margin="0,8,0,0">
                            <Button Content="New" Click="NewProfile_Click"/>
                            <Button Content="Duplicate" Click="DuplicateProfile_Click"/>
                            <Button Content="Rename" Click="RenameProfile_Click"/>
                            <Button Content="Delete" Click="DeleteProfile_Click"/>
                            <Button Content="Import" Click="ImportProfile_Click"/>
                            <Button Content="Export" Click="ExportProfile_Click"/>
                        </UniformGrid>
                        <TextBlock Margin="0 16, 0 0" Text="Other" Style="{StaticResource SectionTitle}"/>
                        <Button Content="Macros" Margin="2,18,2,2" Click="Macros_Click"/>
                        <Button Content="Lighting" Margin="2,2,2,2" Click="Lighting_Click"/>
                        <Button Content="Settings" Margin="2,2,2,2" Click="Settings_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Deck -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20,24,20">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Add page" Click="AddPage_Click"/>
                            <Button Content="Rename" Click="RenamePage_Click"/>
                            <Button Content="Delete" Click="DeletePage_Click"/>
                        </StackPanel>
                        <ListBox x:Name="PageList" ItemContainerStyle="{StaticResource PageTab}"
                                 SelectionChanged="PageList_SelectionChanged" VerticalAlignment="Center"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <Border Margin="0,16,0,0" Padding="12" CornerRadius="18" Background="{StaticResource Inset}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1" HorizontalAlignment="Center">
                        <ItemsControl x:Name="KeyGrid" ItemTemplate="{StaticResource KeyTemplate}" AllowDrop="True"
                                      PreviewMouseLeftButtonUp="KeyGrid_Click"
                                      PreviewMouseRightButtonUp="KeyGrid_RightClick"
                                      DragOver="KeyGrid_DragOver" Drop="KeyGrid_Drop">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>
                    <TextBlock Text="Drop a picture on a key to set its image. Right-click a key for more."
                               Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,8,0,0"/>

                    <TextBlock Text="Side buttons" TextAlignment="Center" Style="{StaticResource SectionTitle}" Margin="0,22,0,6"/>
                    <ItemsControl x:Name="SideGrid" HorizontalContentAlignment="Center" ItemTemplate="{StaticResource SideTemplate}"
                                  PreviewMouseLeftButtonUp="SideGrid_Click">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Key editor -->
            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <TextBlock x:Name="EditorEmpty" Text="Select a key or side button to edit it."
                                   Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                        <StackPanel x:Name="EditorBody" Visibility="Collapsed">
                            <TextBlock x:Name="EditorTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>

                            <StackPanel x:Name="LookSection">
                                <TextBlock Text="Label" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="LabelBox" MaxLength="24" TextChanged="Editor_Changed"/>
                                <TextBlock Text="Image" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Choose image" Click="ChooseImage_Click" Margin="0,2,6,2"/>
                                    <Button Content="Remove" Click="RemoveImage_Click"/>
                                </StackPanel>
                                <TextBlock Text="Background colour" Style="{StaticResource FieldLabel}"/>
                                <local:ColorField x:Name="BgField" ShowPresets="True"/>
                                <TextBlock Text="Show live data" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="DisplayBox" DisplayMemberPath="Text" SelectedValuePath="Value"
                                          SelectionChanged="Editor_Changed"/>
                                <TextBlock Text="Draws the value large on the key. Needs 'Use SimHub data' switched on in Settings."
                                           Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>
                                <StackPanel x:Name="LiveOptions" Margin="0,10,0,0">
                                    <CheckBox x:Name="RpmBgCheck" Content="Background colour follows RPM"
                                              Click="Editor_Changed" Margin="0,0,0,8"
                                              ToolTip="Uses the RPM colours and ranges from the Lighting window."/>
                                    <CheckBox x:Name="RedlineBlinkCheck" Content="Flash at the redline"
                                              Click="Editor_Changed"
                                              ToolTip="Flashes in the top RPM colour (red by default) near the limiter."/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="When pressed" Style="{StaticResource FieldLabel}" Margin="0,22,0,5"/>
                            <ComboBox x:Name="ActionBox" DisplayMemberPath="Text" SelectedValuePath="Value"
                                      SelectionChanged="ActionBox_SelectionChanged"/>

                            <StackPanel x:Name="HotkeyPanel">
                                <TextBlock Text="Keys" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="HotkeyBox" ToolTip="Click here, then press the keys you want."/>
                                <TextBlock Text="Click the box and press the keys. They are held while you hold the button."
                                           Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="Pick from keyboard" Click="PickHotkey_Click" Margin="0,2,6,2"/>
                                    <Button Content="Clear keys" Click="ClearHotkey_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="MacroPanel">
                                <TextBlock Text="Macro" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="MacroBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                                          SelectionChanged="Editor_Changed"/>
                                <Button Content="Edit macros" HorizontalAlignment="Left" Click="Macros_Click" Margin="0,8,0,0"/>
                            </StackPanel>

                            <StackPanel x:Name="PagePanel">
                                <TextBlock Text="Page" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="PageTargetBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                                          SelectionChanged="Editor_Changed"/>
                            </StackPanel>

                            <StackPanel x:Name="ProfilePanel">
                                <TextBlock Text="Preset" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="ProfileTargetBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                                          SelectionChanged="Editor_Changed"/>
                            </StackPanel>

                            <StackPanel x:Name="AppPanel">
                                <TextBlock Text="Program" Style="{StaticResource FieldLabel}"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseProgram_Click" Margin="6,0,0,0"/>
                                    <TextBox x:Name="PathBox" TextChanged="Editor_Changed"/>
                                </DockPanel>
                                <TextBlock Text="Arguments (optional)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ArgsBox" TextChanged="Editor_Changed"/>
                                <CheckBox x:Name="UseIconCheck" Content="Use the program's icon as the key image"
                                          Click="Editor_Changed" Margin="0,16,0,0"/>
                                <TextBlock Text="Only used when the key has no picture of its own."
                                           Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,0"/>
                            </StackPanel>

                            <Button Content="Clear this key" HorizontalAlignment="Left" Margin="0,28,0,0"
                                    Click="ClearKey_Click"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="18,7">
            <DockPanel>
                <TextBlock x:Name="InputLine" DockPanel.Dock="Right" Text="Last press: none yet"
                           Foreground="{StaticResource Muted}"/>
                <TextBlock x:Name="DeckLine" Foreground="{StaticResource Muted}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>

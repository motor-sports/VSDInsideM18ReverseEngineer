<Window x:Class="VSDM18App.LightingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VSDM18App"
        Title="Lighting" Width="610" Height="750"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Base}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,26,30,26">
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="Changes show on the deck straight away and are saved with this preset."
                       Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>

            <!-- Fixed colours -->
            <TextBlock Text="Fixed colours" Style="{StaticResource SectionTitle}" Margin="0,26,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Ring" VerticalAlignment="Center" Margin="0,4"/>
                <local:ColorField Grid.Row="0" Grid.Column="1" x:Name="RingField" Margin="0,4"/>
                <TextBlock Grid.Row="1" Text="Left light" VerticalAlignment="Center" Margin="0,4"/>
                <local:ColorField Grid.Row="1" Grid.Column="1" x:Name="LeftField" Margin="0,4"/>
                <TextBlock Grid.Row="2" Text="Right light" VerticalAlignment="Center" Margin="0,4"/>
                <local:ColorField Grid.Row="2" Grid.Column="1" x:Name="RightField" Margin="0,4"/>
                <TextBlock Grid.Row="3" Text="Brightness" VerticalAlignment="Center" Margin="0,4"/>
                <Slider Grid.Row="3" Grid.Column="1" x:Name="BrightnessSlider" Minimum="0" Maximum="100"
                        Width="280" HorizontalAlignment="Left" VerticalAlignment="Center"
                        ValueChanged="Brightness_Changed"/>
            </Grid>
            <TextBlock Text="These show whenever SimHub isn't sending game data, or no flag is out."
                       Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,0"/>

            <!-- What drives the lights -->
            <TextBlock Text="What the lights show" Style="{StaticResource SectionTitle}" Margin="0,28,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Ring" VerticalAlignment="Center" Margin="0,4"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="RingModeBox" Width="280" HorizontalAlignment="Left"
                          Margin="0,4" DisplayMemberPath="Text" SelectedValuePath="Value"
                          SelectionChanged="RingMode_Changed"/>
                <TextBlock Grid.Row="1" Text="Left and right lights" VerticalAlignment="Center" Margin="0,4"/>
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="SideModeBox" Width="280" HorizontalAlignment="Left"
                          Margin="0,4" DisplayMemberPath="Text" SelectedValuePath="Value"
                          SelectionChanged="SideMode_Changed"/>
            </Grid>
            <TextBlock x:Name="SimStatusText" Foreground="{StaticResource Muted}" FontSize="11.5"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>

            <!-- RPM -->
            <TextBlock Text="RPM" Style="{StaticResource SectionTitle}" Margin="0,28,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Ring style" VerticalAlignment="Center" Margin="0,4"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="RpmStyleBox" Width="280" HorizontalAlignment="Left"
                          Margin="0,4" DisplayMemberPath="Text" SelectedValuePath="Value"
                          SelectionChanged="RpmStyle_Changed"/>

                <TextBlock Grid.Row="1" Text="Starts at" VerticalAlignment="Center" Margin="0,4"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                    <Slider x:Name="RpmStartSlider" Minimum="0" Maximum="95" Width="240" VerticalAlignment="Center"
                            IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="RpmStart_Changed"/>
                    <TextBlock x:Name="RpmStartText" Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="36"
                               Foreground="{StaticResource Muted}"/>
                    <TextBlock Text="of max RPM" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="Bar first LED" VerticalAlignment="Center" Margin="0,4"/>
                <StackPanel Grid.Row="2" Grid.Column="1" x:Name="BarOptions" Orientation="Horizontal" Margin="0,4">
                    <Slider x:Name="RingOffsetSlider" Minimum="0" Maximum="21" Width="170" VerticalAlignment="Center"
                            IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="RingOffset_Changed"/>
                    <TextBlock x:Name="RingOffsetText" Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="24"
                               Foreground="{StaticResource Muted}"/>
                    <CheckBox x:Name="RingReverseCheck" Content="Reverse direction" Margin="16,0,0,0"
                              Click="RingReverse_Click"/>
                </StackPanel>

                <TextBlock Grid.Row="3" Text="Low range colour" VerticalAlignment="Center" Margin="0,4"/>
                <local:ColorField Grid.Row="3" Grid.Column="1" x:Name="LowField" Margin="0,4"/>
                <TextBlock Grid.Row="4" Text="Low range share" VerticalAlignment="Center" Margin="0,4"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                    <Slider x:Name="LowShareSlider" Minimum="0" Maximum="100" Width="240" VerticalAlignment="Center"
                            IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Share_Changed"/>
                    <TextBlock x:Name="LowShareText" Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="40"
                               Foreground="{StaticResource Muted}"/>
                </StackPanel>
                <TextBlock Grid.Row="5" Text="Middle range colour" VerticalAlignment="Center" Margin="0,4"/>
                <local:ColorField Grid.Row="5" Grid.Column="1" x:Name="MidField" Margin="0,4"/>
                <TextBlock Grid.Row="6" Text="Middle range share" VerticalAlignment="Center" Margin="0,4"/>
                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                    <Slider x:Name="MidShareSlider" Minimum="0" Maximum="100" Width="240" VerticalAlignment="Center"
                            IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Share_Changed"/>
                    <TextBlock x:Name="MidShareText" Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="40"
                               Foreground="{StaticResource Muted}"/>
                </StackPanel>
                <TextBlock Grid.Row="7" Text="Top range colour" VerticalAlignment="Center" Margin="0,4"/>
                <local:ColorField Grid.Row="7" Grid.Column="1" x:Name="HighField" Margin="0,4"/>
                <TextBlock Grid.Row="8" Text="Top range share" VerticalAlignment="Center" Margin="0,4"/>
                <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                    <Slider x:Name="HighShareSlider" Minimum="0" Maximum="100" Width="240" VerticalAlignment="Center"
                            IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Share_Changed"/>
                    <TextBlock x:Name="HighShareText" Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="40"
                               Foreground="{StaticResource Muted}"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="RpmHint" Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap"
                       Margin="0,6,0,0"/>

            <!-- Redline -->
            <TextBlock Text="Redline" Style="{StaticResource SectionTitle}" Margin="0,28,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Redline starts at" VerticalAlignment="Center" Margin="0,4"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                    <Slider x:Name="RedlineSlider" Minimum="50" Maximum="100" Width="240" VerticalAlignment="Center"
                            IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Redline_Changed"/>
                    <TextBlock x:Name="RedlineText" Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="40"
                               Foreground="{StaticResource Muted}"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="Lights" VerticalAlignment="Center" Margin="0,4"/>
                <CheckBox Grid.Row="1" Grid.Column="1" x:Name="RedlineFlashCheck" Content="Flash at the redline"
                          Margin="0,4" Click="RedlineFlash_Click"/>
                <TextBlock Grid.Row="2" Text="Flash speed" VerticalAlignment="Center" Margin="0,4"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                    <Slider x:Name="RedlineBlinkSlider" Minimum="50" Maximum="500" Width="240" VerticalAlignment="Center"
                            IsSnapToTickEnabled="True" TickFrequency="10" ValueChanged="RedlineBlink_Changed"/>
                    <TextBlock x:Name="RedlineBlinkText" Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="60"
                               Foreground="{StaticResource Muted}"/>
                </StackPanel>
            </Grid>
            <TextBlock Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="The redline is a percentage of the max RPM SimHub reports for the car. If nothing flashes, lower it. Keys set to flash at the redline use it too, but never flash faster than every 150 ms."/>

            <!-- Flags -->
            <TextBlock Text="Flags" Style="{StaticResource SectionTitle}" Margin="0,28,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Blink speed" VerticalAlignment="Center" Margin="0,4"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                    <Slider x:Name="FlagBlinkSlider" Minimum="100" Maximum="600" Width="240" VerticalAlignment="Center"
                            IsSnapToTickEnabled="True" TickFrequency="10" ValueChanged="FlagBlink_Changed"/>
                    <TextBlock x:Name="FlagBlinkText" Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="60"
                               Foreground="{StaticResource Muted}"/>
                </StackPanel>
            </Grid>
            <StackPanel x:Name="FlagRows" Margin="0,8,0,0"/>
            <TextBlock Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Pick a colour for each flag and whether it blinks. These apply to the lights and to flag display keys. If several flags are out, the one nearest the top of this list is shown. Not every game reports every flag."/>
        </StackPanel>
    </ScrollViewer>
</Window>
